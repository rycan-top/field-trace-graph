<?xml version="1.0" encoding="UTF-8"?>
<!-- 作用：CLI 模块构建定义，装配内部模块、picocli，并用 shade 打可执行 JAR。 -->
<!-- 使用场景：修改入口类、打包方式或排查 JAR 启动问题时。 -->
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>

    <parent>
        <groupId>io.fieldtracegraph</groupId>
        <artifactId>field-trace-graph-parent</artifactId>
        <version>0.1.1</version>
    </parent>

    <artifactId>lineage-cli</artifactId>
    <packaging>jar</packaging>
    <name>lineage-cli</name>
    <description>CLI controllers, application services, views, and dependency assembly</description>

    <dependencies>
        <dependency>
            <groupId>io.fieldtracegraph</groupId>
            <artifactId>lineage-core</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fieldtracegraph</groupId>
            <artifactId>lineage-java</artifactId>
        </dependency>
        <dependency>
            <groupId>io.fieldtracegraph</groupId>
            <artifactId>lineage-storage-sqlite</artifactId>
        </dependency>
        <dependency>
            <groupId>info.picocli</groupId>
            <artifactId>picocli</artifactId>
        </dependency>
        <dependency>
            <groupId>com.fasterxml.jackson.core</groupId>
            <artifactId>jackson-databind</artifactId>
        </dependency>
    </dependencies>

    <build>
        <plugins>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-compiler-plugin</artifactId>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-shade-plugin</artifactId>
                <executions>
                    <execution>
                        <phase>package</phase>
                        <goals>
                            <goal>shade</goal>
                        </goals>
                        <configuration>
                            <finalName>field-trace-graph</finalName>
                            <createDependencyReducedPom>false</createDependencyReducedPom>
                            <transformers>
                                <transformer implementation="org.apache.maven.plugins.shade.resource.ManifestResourceTransformer">
                                    <mainClass>io.fieldtracegraph.cli.bootstrap.FieldTraceGraphApplication</mainClass>
                                </transformer>
                            </transformers>
                            <filters>
                                <filter>
                                    <artifact>*:*</artifact>
                                    <excludes>
                                        <exclude>META-INF/*.SF</exclude>
                                        <exclude>META-INF/*.DSA</exclude>
                                        <exclude>META-INF/*.RSA</exclude>
                                    </excludes>
                                </filter>
                            </filters>
                        </configuration>
                    </execution>
                </executions>
            </plugin>
        </plugins>
    </build>
</project>
